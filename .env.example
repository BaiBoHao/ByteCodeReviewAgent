# OpenAI-compatible model endpoint. Values below are placeholders, not secrets.
REVIEW_AGENT_LLM_BASE_URL=https://api.example.com/v1
REVIEW_AGENT_LLM_API_KEY=replace-me
REVIEW_AGENT_LLM_MODEL=replace-me

# Keep prices configurable because providers change them independently.
REVIEW_AGENT_INPUT_PRICE_CNY_PER_MILLION=0
REVIEW_AGENT_OUTPUT_PRICE_CNY_PER_MILLION=0

# Add self-hosted GitLab/GitHub hosts explicitly.
REVIEW_AGENT_ALLOWED_HOSTS=github.com,gitlab.com

# Provider credentials are optional for public repositories.
GITHUB_TOKEN=
GITLAB_TOKEN=
