# 复制本文件为 .env 后填写。`.env` 已被 Git 忽略，禁止提交真实密钥。
# OpenAI-compatible 模型地址。以下值仅为示例。
REVIEW_AGENT_LLM_BASE_URL=https://api.example.com/v1
REVIEW_AGENT_LLM_API_KEY=replace-me
REVIEW_AGENT_LLM_MODEL=replace-me

# 每百万 Token 的人民币估算价格，用于本地预算保护。
REVIEW_AGENT_INPUT_PRICE_CNY_PER_MILLION=0
REVIEW_AGENT_OUTPUT_PRICE_CNY_PER_MILLION=0

# 自建 GitLab/GitHub 域名需要显式加入白名单。
REVIEW_AGENT_ALLOWED_HOSTS=github.com,gitlab.com

# 公共仓库不需要 Provider Token；私有仓库按需配置最小只读权限。
GITHUB_TOKEN=
GITLAB_TOKEN=
