{
  "manifest_version": 3,
  "name": "Review Agent",
  "description": "在 GitHub PR 和 GitLab MR 页面调用本地 Review Agent。",
  "version": "0.1.0",
  "minimum_chrome_version": "114",
  "permissions": ["activeTab", "sidePanel", "storage", "tabs"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://github.com/*",
    "https://gitlab.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开 Review Agent"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
